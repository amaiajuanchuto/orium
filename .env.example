# Copy to .env and fill in real values. Never commit the real .env — it's
# gitignored on purpose.

# --- Server runtime (see README.md "Run the server") ---
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
PUBLIC_URL=https://your-app.onrender.com
PORT=3000

# --- Backup pipeline (see server/scripts/) ---
# Passphrase used to AES-256-GCM encrypt backups before they leave our own
# infrastructure (e.g. before uploading to Google Drive).
BACKUP_PASSPHRASE=
# Supabase Postgres password, used when constructing a direct DATABASE_URL
# for backup/restore runs outside the app server itself.
DB_PASSWORD=
